<Page Title="Upload File">

<h3>Upload File</h3>

<EditForm Model="_fileModel" OnValidSubmit="HandleFileUpload">
    <InputFile OnChange="HandleSelection" />
    <br />
    <button type="submit">Upload</button>
</EditForm>

@if (_uploadSuccess)
{
    <p>File uploaded successfully!</p>
}

@code {
    private IBrowserFile? _selectedFile;
    private bool _uploadSuccess;

    private void HandleSelection(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
    }

    private async Task HandleFileUpload()
    {
        if (_selectedFile is null)
        {
            return;
        }

        using var stream = _selectedFile.OpenReadStream();
        await FileStorageService.UploadFileAsync(_selectedFile.Name, stream, _selectedFile.ContentType);
        _uploadSuccess = true;
    }

    [Inject]
    private FileStorageService FileStorageService { get; set; } = default!;
}